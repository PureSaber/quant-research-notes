{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.puresaber.dev/m8/factor-spec.schema.json",
  "x-puresaber-schema-id": "puresaber.factor-spec@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "factor_id",
    "version",
    "algorithm_id",
    "input_profile",
    "dependencies",
    "window_periods",
    "dtype",
    "annualized",
    "missing_policy"
  ],
  "properties": {
    "factor_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "algorithm_id": {"type": "string", "minLength": 1},
    "input_profile": {"enum": ["bar", "market_event"]},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "value_column", "availability_column"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "value_column": {"type": "string", "minLength": 1},
          "availability_column": {"type": "string", "minLength": 1}
        }
      }
    },
    "window_periods": {"type": "integer", "minimum": 1},
    "dtype": {"const": "float64"},
    "annualized": {"type": "boolean"},
    "missing_policy": {"enum": ["null", "error"]}
  }
}
