{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.puresaber.dev/m8/auxiliary-source.schema.json",
  "x-puresaber-schema-id": "puresaber.auxiliary-source@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "schema_id",
    "schema_version",
    "snapshot_id",
    "physical_sha256",
    "logical_sha256",
    "business_key_columns",
    "observation_time_column",
    "effective_from_column",
    "effective_to_column",
    "available_at_column",
    "superseded_at_column",
    "revision_column",
    "value_availability",
    "join_recipe"
  ],
  "properties": {
    "role": {"type": "string", "minLength": 1},
    "schema_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
    "physical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "business_key_columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observation_time_column": {"type": "string", "minLength": 1},
    "effective_from_column": {"type": "string", "minLength": 1},
    "effective_to_column": {"type": "string", "minLength": 1},
    "available_at_column": {"type": "string", "minLength": 1},
    "superseded_at_column": {"type": "string", "minLength": 1},
    "revision_column": {"type": "string", "minLength": 1},
    "value_availability": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "join_recipe": {"type": "string", "minLength": 1}
  }
}
