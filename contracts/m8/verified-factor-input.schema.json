{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.puresaber.dev/m8/verified-factor-input.schema.json",
  "x-puresaber-schema-id": "puresaber.verified-factor-input@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "layer",
    "source_snapshot_id",
    "source_logical_sha256",
    "selection_logical_sha256",
    "event_schemas",
    "calendar_id",
    "session_policy_version",
    "market_context_snapshot_id",
    "market_context_logical_sha256",
    "lineage",
    "rows",
    "arrow_schema_sha256",
    "aggregation"
  ],
  "properties": {
    "schema_id": {"const": "puresaber.verified-factor-input@1.0.0"},
    "layer": {"enum": ["curated", "normalized"]},
    "source_snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
    "source_logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection_logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_schemas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/event_schema"}
    },
    "calendar_id": {"type": "string", "minLength": 1},
    "session_policy_version": {"type": "string", "minLength": 1},
    "market_context_snapshot_id": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "market_context_logical_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "snapshot_id", "logical_sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
          "logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "rows": {"type": "integer", "minimum": 1},
    "arrow_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregation": {
      "oneOf": [{"$ref": "curated-aggregation.schema.json"}, {"type": "null"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"layer": {"const": "curated"}}},
      "then": {
        "properties": {
          "aggregation": {"type": "object"},
          "event_schemas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["schema_id", "schema_version"],
                "properties": {
                  "schema_id": {"const": "puresaber.bar-event"},
                  "schema_version": {"const": "2.0.0"}
                }
              }
            ],
            "items": false
          }
        }
      }
    },
    {
      "if": {"properties": {"layer": {"const": "normalized"}}},
      "then": {
        "properties": {
          "aggregation": {"type": "null"},
          "event_schemas": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/event_schema"},
                {"not": {"properties": {"schema_id": {"const": "puresaber.bar-event"}}}}
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "event_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^puresaber\\.[a-z0-9._-]+$"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
