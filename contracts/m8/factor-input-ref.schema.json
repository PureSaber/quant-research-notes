{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.puresaber.dev/m8/factor-input-ref.schema.json",
  "x-puresaber-schema-id": "puresaber.factor-input-ref@1.0.0",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "root",
        "dataset",
        "snapshot_id",
        "event_schema_ids",
        "market_context_snapshot_id"
      ],
      "properties": {
        "layer": {"const": "curated"},
        "root": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
        "event_schema_ids": {"type": "null"},
        "market_context_snapshot_id": {"type": "null"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "root",
        "dataset",
        "snapshot_id",
        "event_schema_ids",
        "market_context_snapshot_id"
      ],
      "properties": {
        "layer": {"const": "normalized"},
        "root": {"type": "string", "minLength": 1},
        "dataset": {"type": "null"},
        "snapshot_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
        "event_schema_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^puresaber\\.[a-z0-9._-]+$"}
        },
        "market_context_snapshot_id": {
          "type": "string",
          "pattern": "^sha256-[0-9a-f]{64}$"
        }
      }
    }
  ]
}
